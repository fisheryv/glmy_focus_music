# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and local environment
.env
*.local.toml

# Raw audio is never versioned.
data_raw/

# Re-downloadable upstream metadata repositories and request caches
data_sources/**
!data_sources/README.md

# Generated or derived artifacts
features/**
!features/**/
!features/**/README.md
graphs/**
!graphs/**/
!graphs/**/README.md
homology/**
!homology/**/
!homology/**/README.md
generation/baseline/**
generation/steered/**
!generation/baseline/
!generation/steered/
!generation/baseline/README.md
!generation/steered/README.md
human_study/anonymized_scores/*.csv
!human_study/anonymized_scores/schema.csv

# Local dataset build state (canonical manifests remain tracked)
metadata/*.part
metadata/download_failures.csv

# Local archive for the retired, non-redistributable Brain.fm baseline.
restricted_archive/**

# Local archive for comparison groups removed from the canonical dataset.
dataset_archive/

# Historical analysis snapshots superseded by canonical reruns.
analysis_archive/**

# Experiment logs and model artifacts
runs/
checkpoints/
*.ckpt
*.safetensors
*.pt
*.pth

# Nested ACE-Step repository (tracked separately via reproducibility/commit_hash.txt)
ACE-Step-1.5/

# Temporary render and cache files
tmp/
papers/tmp/

# Generated Hugging Face release staging (includes hard-linked source audio)
hf_release/

# Downloaded immutable dataset snapshots and external source checkouts
dataset/
datasets/
external/

# Local-only packages, documentation, generated output, and examples
package/
packages/
docs/
output/
examples/

# Office lock files
**/~$*

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
## Keep compiled PDFs for papers
!papers/*.pdf
